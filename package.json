{
  "name": "sports-motion-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check --error-on-warnings packages apps scripts",
    "check:boundaries": "node scripts/check-ts-boundaries.mjs",
    "check:boundaries:self-test": "node scripts/check-ts-boundaries.mjs --self-test",
    "test:contracts": "pnpm --filter @sports-motion/contracts run test:contracts",
    "test:g3": "pnpm --filter @sports-motion/contracts run test:g3",
    "test": "pnpm --filter @sports-motion/contracts run build && pnpm -r run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
