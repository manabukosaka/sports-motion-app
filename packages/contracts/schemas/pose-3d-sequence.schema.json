{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sports-motion-app.invalid/contracts/pose-3d-sequence.schema.json",
  "title": "Pose3DSequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "coordinate_frame", "unit", "is_metric_calibrated", "provenance",
    "frames", "bone_length_stability_mm"
  ],
  "properties": {
    "contract_version": {"$ref": "common.schema.json#/$defs/semver"},
    "coordinate_frame": {"enum": ["CalibratedWorld3D", "HipRelative3D"]},
    "unit": {"const": "m"},
    "is_metric_calibrated": {"type": "boolean"},
    "provenance": {"$ref": "common.schema.json#/$defs/analysis_provenance"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "description": "Frame indices and timestamps must each strictly increase on the sequence time axis.",
      "items": {"$ref": "#/$defs/frame"}
    },
    "bone_length_stability_mm": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Maximum across bones of the time-series population standard deviation of reconstructed bone length in mm. Null when no bone has two usable samples."
    }
  },
  "if": {"properties": {"coordinate_frame": {"const": "CalibratedWorld3D"}}},
  "then": {
    "properties": {
      "is_metric_calibrated": {"const": true},
      "provenance": {"properties": {"calibration_id_or_none": {"not": {"const": "none"}}}}
    }
  },
  "else": {"properties": {"is_metric_calibrated": {"const": false}}},
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "timestamp_sec", "landmarks"],
      "properties": {
        "frame_index": {"$ref": "common.schema.json#/$defs/frame_index"},
        "timestamp_sec": {"$ref": "common.schema.json#/$defs/timestamp_sec"},
        "landmarks": {"type": "array", "items": {"$ref": "#/$defs/landmark"}}
      }
    },
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landmark_id", "x", "y", "z", "source", "missing_reason"],
      "properties": {
        "landmark_id": {"$ref": "common.schema.json#/$defs/non_blank_string"},
        "x": {"type": ["number", "null"]},
        "y": {"type": ["number", "null"]},
        "z": {"type": ["number", "null"]},
        "source": {"$ref": "common.schema.json#/$defs/observation_source"},
        "missing_reason": {
          "anyOf": [{"$ref": "common.schema.json#/$defs/missing_reason"}, {"type": "null"}]
        }
      },
      "if": {"properties": {"missing_reason": {"type": "null"}}},
      "then": {"properties": {"x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"}}},
      "else": {"properties": {"x": {"type": "null"}, "y": {"type": "null"}, "z": {"type": "null"}}}
    }
  }
}
