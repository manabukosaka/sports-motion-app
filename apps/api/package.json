{
  "name": "@sports-motion/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/verify-*.test.ts' --exclude '**/*.integration.test.ts'",
    "test:vertical-slice": "vitest run --no-file-parallelism tests/vertical-slice.integration.test.ts tests/editing-recompute.integration.test.ts",
    "verify:lifecycle": "vitest run tests/verify-lifecycle.test.ts",
    "verify:access-policy": "vitest run tests/verify-access-policy.test.ts"
  },
  "dependencies": {
    "@sports-motion/contracts": "workspace:*",
    "@sports-motion/editing": "workspace:*",
    "@sports-motion/evidence": "workspace:*"
  },
  "devDependencies": {
    "@sports-motion/share-web": "workspace:*"
  }
}
